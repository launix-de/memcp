		"suggested_assembly_qualified_type_name" nil "suggested_xml_collection_id" nil "suggested_xml_collection_database" nil
		"suggested_xml_collection_schema" nil "suggested_xml_collection_name" nil "suggested_is_xml_document" 0
		"suggested_is_case_sensitive" 0 "suggested_is_fixed_length_clr_type" 0 "suggested_is_input" 1 "suggested_is_output" 0 "formal_parameter_name" nil
		"suggested_tds_type_id" (get_assoc '("BIGINT" 38 "INT" 38 "INTEGER" 38 "SMALLINT" 38 "TINYINT" 38 "BIT" 104 "BOOLEAN" 104
			"CHAR" 175 "VARCHAR" 167 "NCHAR" 239 "NVARCHAR" 231 "BINARY" 173 "VARBINARY" 165 "DECIMAL" 106 "NUMERIC" 108
			"MONEY" 110 "SMALLMONEY" 110 "FLOAT" 109 "REAL" 109 "DATE" 40 "TIME" 41 "DATETIME2" 42 "DATETIME" 111 "SMALLDATETIME" 111) type)
		"suggested_tds_length" (if (equal? length -1) 65535 length)))))
(define tsql_odbc_describe_parameters (lambda (schema params session) (begin
	(define names '("tsql" "params"))
	(tsql_odbc_validate_arguments params names)
	(define text (tsql_odbc_argument params names "tsql" nil))
	(if (string? text) true (error "parameter description requires SQL text"))
	(define declarations (tsql_metadata_declared_parameters schema (tsql_odbc_argument params names "params" nil)))
	(define planning_session (newsession))
	(planning_session "tsql_describe_ast" true)
	(define query (parse_tsql schema text (sql_policy (session "username")) planning_session nil))
	(define constraints (tsql_metadata_constraints schema query '() nil declarations))
	(define entries (reduce constraints (lambda (acc constraint) (begin
		(define name (car constraint))
		(define previous (find acc (lambda (entry) (equal? (car entry) name)) nil))
		(if previous
			(begin (define before (nth previous 2)) (define after (nth constraint 2))
				(if (and before after (not (equal? before after))) (error (concat "conflicting parameter type contexts @" name)) true)
				(if (or before (nil? after)) acc (map acc (lambda (entry) (if (equal? (car entry) name) constraint entry)))))
			(append acc constraint)))) '()))
	(define undeclared (filter entries (lambda (entry) (not (has_assoc? declarations (car entry))))))
	(map undeclared (lambda (entry) (if (nil? (nth entry 2)) (error (concat "cannot infer parameter type @" (car entry))) true)))
	(list "fields" (tsql_odbc_fields '( '("parameter_ordinal" "INT" nil false) '("name" "NVARCHAR" 128 false) '("suggested_system_type_id" "INT" nil false) '("suggested_system_type_name" "NVARCHAR" 256 true) '("suggested_max_length" "SMALLINT" nil false) '("suggested_precision" "TINYINT" nil false) '("suggested_scale" "TINYINT" nil false) '("suggested_user_type_id" "INT" nil true) '("suggested_user_type_database" "NVARCHAR" 128 true) '("suggested_user_type_schema" "NVARCHAR" 128 true) '("suggested_user_type_name" "NVARCHAR" 128 true) '("suggested_assembly_qualified_type_name" "NVARCHAR" 4000 true) '("suggested_xml_collection_id" "INT" nil true) '("suggested_xml_collection_database" "NVARCHAR" 128 true) '("suggested_xml_collection_schema" "NVARCHAR" 128 true) '("suggested_xml_collection_name" "NVARCHAR" 128 true) '("suggested_is_xml_document" "BIT" nil false) '("suggested_is_case_sensitive" "BIT" nil false) '("suggested_is_fixed_length_clr_type" "BIT" nil false) '("suggested_is_input" "BIT" nil false) '("suggested_is_output" "BIT" nil false) '("formal_parameter_name" "NVARCHAR" 128 true) '("suggested_tds_type_id" "INT" nil false) '("suggested_tds_length" "INT" nil false)))
		"rows" (mapIndex undeclared (lambda (ordinal entry) (tsql_metadata_parameter_row schema ordinal entry)))))))
/* Key discovery uses the existing table metadata view. */
(define tsql_odbc_key_table (lambda (schema name owner qualifier) (begin
	(tsql_odbc_database schema qualifier)
	(if (string? name) true (error "metadata requires a table name"))
	(define actual (sql_resolve_table_name schema name))
	(if (and actual (or (nil? owner) (equal?? owner "dbo"))) (show (table schema actual) true) nil))))
(define tsql_odbc_pkeys (lambda (schema params) (begin
	(define names '("table_name" "table_owner" "table_qualifier"))
	(tsql_odbc_validate_arguments params names)
	(define metadata (tsql_odbc_key_table schema (tsql_odbc_argument params names "table_name" nil)
		(tsql_odbc_argument params names "table_owner" nil) (tsql_odbc_argument params names "table_qualifier" nil)))
	(list "fields" (tsql_odbc_fields '( '("TABLE_QUALIFIER" "NVARCHAR" 128 true) '("TABLE_OWNER" "NVARCHAR" 128 false)
		'("TABLE_NAME" "NVARCHAR" 128 false) '("COLUMN_NAME" "NVARCHAR" 128 false) '("KEY_SEQ" "SMALLINT" nil false) '("PK_NAME" "NVARCHAR" 128 true)))
		"rows" (if (nil? metadata) '() (merge (map (filter (metadata "Unique") (lambda (key) (equal? (key "Id") "PRIMARY")))
			(lambda (key) (mapIndex (key "Cols") (lambda (ordinal column) (list "TABLE_QUALIFIER" schema "TABLE_OWNER" "dbo"
				"TABLE_NAME" (metadata "Name") "COLUMN_NAME" column "KEY_SEQ" (+ ordinal 1) "PK_NAME" (key "Id"))))))))))))
(define tsql_odbc_statistics (lambda (schema params) (begin
	(define names '("table_name" "table_owner" "table_qualifier" "index_name" "is_unique" "accuracy"))
	(tsql_odbc_validate_arguments params names)
	(define metadata (tsql_odbc_key_table schema (tsql_odbc_argument params names "table_name" nil)
		(tsql_odbc_argument params names "table_owner" nil) (tsql_odbc_argument params names "table_qualifier" nil)))
	(define unique (toUpper (tsql_odbc_argument params names "is_unique" "")))
	(if (has? '("" "Y" "N") unique) true (error "invalid metadata uniqueness flag"))
	(if (equal? (toUpper (tsql_odbc_argument params names "accuracy" "Q")) "Q") true (error "exact index statistics are unavailable"))
	(define pattern (tsql_odbc_argument params names "index_name" "%"))
	(list "fields" (tsql_odbc_fields '( '("TABLE_QUALIFIER" "NVARCHAR" 128 true) '("TABLE_OWNER" "NVARCHAR" 128 false)
		'("TABLE_NAME" "NVARCHAR" 128 false) '("NON_UNIQUE" "SMALLINT" nil false) '("INDEX_QUALIFIER" "NVARCHAR" 128 true)
		'("INDEX_NAME" "NVARCHAR" 128 false) '("TYPE" "SMALLINT" nil false) '("SEQ_IN_INDEX" "SMALLINT" nil false)
		'("COLUMN_NAME" "NVARCHAR" 128 false) '("COLLATION" "VARCHAR" 1 true) '("CARDINALITY" "INT" nil true)
		'("PAGES" "INT" nil true) '("FILTER_CONDITION" "VARCHAR" 128 true)))
		"rows" (if (nil? metadata) '() (merge (map (sort (filter (metadata "Unique") (lambda (key) (tsql_odbc_matches (key "Id") pattern true)))
			(lambda (a b) (< (a "Id") (b "Id")))) (lambda (key) (mapIndex (key "Cols") (lambda (ordinal column)
				(list "TABLE_QUALIFIER" schema "TABLE_OWNER" "dbo" "TABLE_NAME" (metadata "Name") "NON_UNIQUE" 0
					"INDEX_QUALIFIER" (metadata "Name") "INDEX_NAME" (key "Id") "TYPE" 3 "SEQ_IN_INDEX" (+ ordinal 1)
					"COLUMN_NAME" column "COLLATION" "A" "CARDINALITY" nil "PAGES" nil "FILTER_CONDITION" nil)))))))))))
(define tsql_odbc_special_columns (lambda (schema params) (begin
	(define names '("table_name" "table_owner" "table_qualifier" "col_type" "scope" "nullable" "odbcver"))
	(define params (if (has_assoc? params "qualifier")
		(if (has_assoc? params "table_qualifier") (error "duplicate metadata qualifier")
			(set_assoc (filter_assoc params (lambda (key _value) (not (equal? key "qualifier")))) "table_qualifier" (params "qualifier"))) params))
	(tsql_odbc_validate_arguments params names)
	(define metadata (tsql_odbc_key_table schema (tsql_odbc_argument params names "table_name" nil)
		(tsql_odbc_argument params names "table_owner" nil) (tsql_odbc_argument params names "table_qualifier" nil)))
	(define kind (toUpper (tsql_odbc_argument params names "col_type" "R")))
	(define scope (toUpper (tsql_odbc_argument params names "scope" "T")))
	(define nullable (toUpper (tsql_odbc_argument params names "nullable" "U")))
	(define version (tsql_odbc_argument params names "odbcver" 2))
	(if (and (has? '("R" "V") kind) (has? '("C" "T") scope) (has? '("U" "O") nullable) (has? '(2 3) version)) true (error "invalid special-column metadata options"))
	(define columns (if (nil? metadata) '() (metadata "Columns")))
	(define resolve (lambda (name) (find columns (lambda (column) (equal? (column "Field") name)) nil)))
	(define keys (if (nil? metadata) '() (filter (metadata "Unique") (lambda (key)
		(reduce (key "Cols") (lambda (valid name) (and valid (not ((resolve name) "Null")))) true)))))
	(define key (find keys (lambda (key) (equal? (key "Id") "PRIMARY"))
		(if (empty_list? keys) nil (car (sort keys (lambda (a b) (if (equal? (count (a "Cols")) (count (b "Cols"))) (< (a "Id") (b "Id")) (< (count (a "Cols")) (count (b "Cols"))))))))))
	(define selected (if (equal? kind "V") (filter columns (lambda (column) (and (column "RowVersion") (or (equal? nullable "U") (not (column "Null"))))))
		(if (nil? key) '() (map (key "Cols") resolve))))
	(list "fields" (tsql_odbc_fields '( '("SCOPE" "SMALLINT" nil true) '("COLUMN_NAME" "NVARCHAR" 128 false) '("DATA_TYPE" "SMALLINT" nil false)
		'("TYPE_NAME" "NVARCHAR" 128 false) '("PRECISION" "INT" nil true) '("LENGTH" "INT" nil true) '("SCALE" "SMALLINT" nil true) '("PSEUDO_COLUMN" "SMALLINT" nil false)))
		"rows" (map selected (lambda (column) (begin
			(define type (toUpper (if (equal? (coalesceNil (column "SQLDeclaredType") "") "") (column "RawType") (column "SQLDeclaredType"))))
			(define info (tsql_odbc_type type (column "Dimensions") version))
			(list "SCOPE" 0 "COLUMN_NAME" (column "Field") "DATA_TYPE" (info "code") "TYPE_NAME" (toLower type)
				"PRECISION" (info "precision") "LENGTH" (info "length") "SCALE" (info "scale") "PSEUDO_COLUMN" 1))))))))
(define tsql_odbc_fkeys (lambda (schema params) (begin
	(define names '("pktable_name" "pktable_owner" "pktable_qualifier" "fktable_name" "fktable_owner" "fktable_qualifier"))
	(tsql_odbc_validate_arguments params names)
	(tsql_odbc_database schema (tsql_odbc_argument params names "pktable_qualifier" nil))
	(tsql_odbc_database schema (tsql_odbc_argument params names "fktable_qualifier" nil))
	(define primary (tsql_odbc_argument params names "pktable_name" nil))
	(define foreign (tsql_odbc_argument params names "fktable_name" nil))
	(if (or (string? primary) (string? foreign)) true (error "foreign-key metadata requires a table name"))
	(define owners (and (tsql_odbc_matches "dbo" (tsql_odbc_argument params names "pktable_owner" nil) false)
		(tsql_odbc_matches "dbo" (tsql_odbc_argument params names "fktable_owner" nil) false)))
	(define catalog (map (show schema) (lambda (name) (show (table schema name) true))))
	(define selected (filter catalog (lambda (item) (and owners (tsql_odbc_matches (item "Name") foreign false)))))
	(define rule (lambda (mode) (match mode "cascade" 0 "set null" 2 _ 1)))
	(list "fields" (tsql_odbc_fields '( '("PKTABLE_QUALIFIER" "NVARCHAR" 128 true) '("PKTABLE_OWNER" "NVARCHAR" 128 false) '("PKTABLE_NAME" "NVARCHAR" 128 false) '("PKCOLUMN_NAME" "NVARCHAR" 128 false)
		'("FKTABLE_QUALIFIER" "NVARCHAR" 128 true) '("FKTABLE_OWNER" "NVARCHAR" 128 false) '("FKTABLE_NAME" "NVARCHAR" 128 false) '("FKCOLUMN_NAME" "NVARCHAR" 128 false)
		'("KEY_SEQ" "SMALLINT" nil false) '("UPDATE_RULE" "SMALLINT" nil false) '("DELETE_RULE" "SMALLINT" nil false) '("FK_NAME" "NVARCHAR" 128 true) '("PK_NAME" "NVARCHAR" 128 true)))
		"rows" (merge (map selected (lambda (item) (merge (map (sort (filter (item "ForeignKeys") (lambda (key) (and (equal? (key "Role") "referencing") (tsql_odbc_matches (key "OtherTable") primary false))))
			(lambda (a b) (< (a "Id") (b "Id")))) (lambda (key) (begin
				(define parent (find catalog (lambda (candidate) (equal? (candidate "Name") (key "OtherTable"))) nil))
				(define referenced (if (nil? parent) nil (find (parent "Unique") (lambda (candidate) (equal? (candidate "Cols") (key "OtherColumns"))) nil)))
				(mapIndex (key "LocalColumns") (lambda (ordinal column) (list
					"PKTABLE_QUALIFIER" schema "PKTABLE_OWNER" "dbo" "PKTABLE_NAME" (key "OtherTable") "PKCOLUMN_NAME" (nth (key "OtherColumns") ordinal)
					"FKTABLE_QUALIFIER" schema "FKTABLE_OWNER" "dbo" "FKTABLE_NAME" (item "Name") "FKCOLUMN_NAME" column "KEY_SEQ" (+ ordinal 1)
					"UPDATE_RULE" (rule (key "UpdateMode")) "DELETE_RULE" (rule (key "DeleteMode")) "FK_NAME" (key "Id") "PK_NAME" (if referenced (referenced "Id") nil)))))))))))))))
(define tsql_metadata_rpc (lambda (schema name params session) (begin
	(if (and session (session "username")) ((sql_policy (session "username")) schema true false) (error "metadata requires an authenticated session"))
	(match (toLower name)
		"sp_describe_undeclared_parameters" (tsql_odbc_describe_parameters schema params session)
		"sp_pkeys" (tsql_odbc_pkeys schema params)
		"sp_statistics" (tsql_odbc_statistics schema params)
		"sp_special_columns" (tsql_odbc_special_columns schema params)
		"sp_fkeys" (tsql_odbc_fkeys schema params)
		"sp_tables" (tsql_odbc_tables schema params)
		"sp_columns" (tsql_odbc_columns schema params session)
		"sp_datatype_info" (tsql_odbc_datatypes schema params)
		"sp_datatype_info_100" (tsql_odbc_datatypes schema params)
		_ (error (concat "unsupported metadata procedure " name))))))
(define tsql_metadata_emit (lambda (schema name params session resultrow resultfields) (begin
	(define metadata (tsql_metadata_rpc schema name params session))
	(resultfields (map (metadata "fields") (lambda (field) (field "name"))) (metadata "fields"))
	(map (metadata "rows") resultrow)
	nil)))
