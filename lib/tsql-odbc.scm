/* Metadata procedures consume bound values and immutable schema descriptions.
No SQL is synthesized, executed, or inferred from existing row contents. */
(define tsql_odbc_fields (lambda (specs) (map specs (lambda (spec)
	(list "name" (car spec) "sql_type" (nth spec 1) "size" (nth spec 2) "precision" nil "scale" nil "nullable" (nth spec 3) "source" nil)))))
(define tsql_odbc_argument (lambda (params names name fallback) (begin
	(define ordinal (find (produceN (count names)) (lambda (i) (equal? (nth names i) name)) nil))
	(define positional (concat ordinal))
	(if (and (has_assoc? params name) (has_assoc? params positional)) (error (concat "duplicate metadata argument " name)) true)
	(if (has_assoc? params name) (get_assoc params name)
		(if (has_assoc? params positional) (get_assoc params positional) fallback)))))
(define tsql_odbc_validate_arguments (lambda (params names) (extract_assoc params (lambda (key value)
	(if (or (has? names key) (has? (map (produceN (count names)) (lambda (i) (concat i))) key)) true
		(error (concat "unknown metadata argument " key)))))))
(define tsql_odbc_pattern_regex (lambda (pattern) (begin
	(define compile (lambda (position inside)
		(if (>= position (strlen pattern)) (if inside (error "unterminated metadata pattern bracket") "")
			(begin (define character (substr pattern position 1))
				(concat (if inside
					(if (equal? character "]") "]" (if (equal? character "\\") "\\\\" character))
					(match character "%" ".*" "_" "." "[" "["
						_ (if (has? '("\\" "." "^" "$" "*" "+" "?" "(" ")" "{" "}" "|" "]") character) (concat "\\" character) character)))
					(compile (+ position 1) (if inside (not (equal? character "]")) (equal? character "["))))))))
	(concat "(?is)^" (compile 0 false) "$"))))
(define tsql_odbc_matches (lambda (value pattern use_pattern)
	(if (nil? pattern) true (if use_pattern (regexp_test value (tsql_odbc_pattern_regex pattern)) (equal?? value pattern)))))
(define tsql_odbc_database (lambda (schema qualifier)
	(if (or (nil? qualifier) (equal?? qualifier schema)) true (error "metadata qualifier must be the current database"))))
(define tsql_odbc_view_names (lambda (schema)
	(scan nil (table "system" "views")
		(list 369436175368192 (scan_boundary "equal" "database" 0 0 true true "" false)) (list schema)
		'() (lambda () true) '("name") (lambda (acc name) (cons name acc)) '() (lambda (a b) (merge a b)))))
(define tsql_odbc_tables (lambda (schema params) (begin
	(define names '("table_name" "table_owner" "table_qualifier" "table_type" "fusepattern"))
	(tsql_odbc_validate_arguments params names)
	(define table_name (tsql_odbc_argument params names "table_name" nil))
	(define owner (tsql_odbc_argument params names "table_owner" nil))
	(tsql_odbc_database schema (tsql_odbc_argument params names "table_qualifier" nil))
	(define table_type (tsql_odbc_argument params names "table_type" nil))
	(define patterns (tsql_odbc_argument params names "fusepattern" 1))
	(if (has? '(0 1 false true) patterns) true (error "invalid metadata pattern flag"))
	(define types (if (nil? table_type) '("TABLE" "VIEW" "SYSTEM TABLE")
		(map (split table_type ",") (lambda (kind) (toUpper (replace (strtrim kind) "'" ""))))))
	(if (reduce types (lambda (valid kind) (and valid (has? '("TABLE" "VIEW" "SYSTEM TABLE") kind))) true) true (error "invalid metadata table type"))
	(define tables (map (show schema) (lambda (name) (list name "TABLE"))))
	(define views (map (tsql_odbc_view_names schema) (lambda (name) (list name "VIEW"))))
	(list "fields" (tsql_odbc_fields '('("TABLE_QUALIFIER" "NVARCHAR" 128 true) '("TABLE_OWNER" "NVARCHAR" 128 false)
		'("TABLE_NAME" "NVARCHAR" 128 false) '("TABLE_TYPE" "VARCHAR" 32 false) '("REMARKS" "VARCHAR" 254 true)))
		"rows" (map (filter (sort (merge tables views) (lambda (a b) (if (equal? (cadr a) (cadr b)) (< (car a) (car b)) (< (cadr a) (cadr b)))))
			(lambda (item) (and (has? types (cadr item)) (tsql_odbc_matches "dbo" owner (not (equal? patterns 0)))
				(tsql_odbc_matches (car item) table_name (not (equal? patterns 0))))))
			(lambda (item) (list "TABLE_QUALIFIER" schema "TABLE_OWNER" "dbo" "TABLE_NAME" (car item) "TABLE_TYPE" (cadr item) "REMARKS" nil)))))))
(define tsql_odbc_type (lambda (type dimensions version) (begin
	(define type (toUpper type))
	(define temporal (get_assoc '("DATE" 1 "TIME" 2 "DATETIME" 3 "DATETIME2" 3 "SMALLDATETIME" 3) type))
	(define code (if temporal (if (equal? version 3) (+ 90 temporal) (+ 8 temporal))
		(get_assoc '("BIGINT" -5 "BINARY" -2 "VARBINARY" -3 "ROWVERSION" -2 "TIMESTAMP" -2 "BIT" -7 "BOOLEAN" -7
			"CHAR" 1 "VARCHAR" 12 "NCHAR" -8 "NVARCHAR" -9 "TEXT" -1 "NTEXT" -10 "DECIMAL" 3 "NUMERIC" 2
			"MONEY" 3 "SMALLMONEY" 3 "FLOAT" 8 "REAL" 7 "INT" 4 "INTEGER" 4 "SMALLINT" 5 "TINYINT" -6) type)))
	(if (nil? code) (error (concat "unsupported ODBC metadata type " type)) true)
	(define size (if (empty_list? dimensions) nil (car dimensions)))
	(define precision (if (has? '("TIME" "DATETIME2") type)
		(+ (if (equal? type "TIME") 8 19) (if (> (coalesceNil size 7) 0) (+ 1 (coalesceNil size 7)) 0))
		(if (has? '("NCHAR" "NVARCHAR" "CHAR" "VARCHAR" "BINARY" "VARBINARY") type) size
			(if (has? '("DECIMAL" "NUMERIC") type) size
				(get_assoc '("BIGINT" 19 "BIT" 1 "BOOLEAN" 1 "FLOAT" 15 "REAL" 7 "INT" 10 "INTEGER" 10 "SMALLINT" 5 "TINYINT" 3
					"MONEY" 19 "SMALLMONEY" 10 "DATE" 10 "TIME" 8 "DATETIME" 23 "DATETIME2" 27 "SMALLDATETIME" 16 "ROWVERSION" 8 "TIMESTAMP" 8 "TEXT" 2147483647 "NTEXT" 1073741823) type)))))
	(define scale (if temporal (if (has? '("DATE" "SMALLDATETIME") type) 0 (if (has? '("TIME" "DATETIME2") type) (coalesceNil size 7) 3))
		(if (has? '("DECIMAL" "NUMERIC") type) (match dimensions '(_ decimals) decimals _ 0)
			(if (has? '("MONEY" "SMALLMONEY") type) 4 (if (has? '("BIGINT" "INT" "INTEGER" "SMALLINT" "TINYINT" "BIT" "BOOLEAN") type) 0 nil)))))
	(list "code" code "sql_code" (if temporal 9 code) "temporal" temporal "precision" precision "scale" scale
		"length" (tsql_col_length_value type dimensions) "radix" (if (has? '("FLOAT" "REAL") type) 2
			(if (has? '("DECIMAL" "NUMERIC" "MONEY" "SMALLMONEY" "BIGINT" "INT" "INTEGER" "SMALLINT" "TINYINT") type) 10 nil))
		"octets" (if (has? '("CHAR" "VARCHAR" "NCHAR" "NVARCHAR" "TEXT" "NTEXT" "BINARY" "VARBINARY" "ROWVERSION" "TIMESTAMP") type) (tsql_col_length_value type dimensions) nil)))))
(define tsql_odbc_columns (lambda (schema params session) (begin
	(define names '("table_name" "table_owner" "table_qualifier" "column_name" "odbcver"))
	(tsql_odbc_validate_arguments params names)
	(define table_name (tsql_odbc_argument params names "table_name" nil))
	(if (nil? table_name) (error "sp_columns requires table_name") true)
	(define owner (tsql_odbc_argument params names "table_owner" nil))
	(tsql_odbc_database schema (tsql_odbc_argument params names "table_qualifier" nil))
	(define column_name (tsql_odbc_argument params names "column_name" nil))
	(define version (tsql_odbc_argument params names "odbcver" 2))
	(if (has? '(2 3) version) true (error "ODBC metadata version must be 2 or 3"))
	(list "fields" (tsql_odbc_fields '('("TABLE_QUALIFIER" "NVARCHAR" 128 true) '("TABLE_OWNER" "NVARCHAR" 128 true)
		'("TABLE_NAME" "NVARCHAR" 128 false) '("COLUMN_NAME" "NVARCHAR" 128 false) '("DATA_TYPE" "SMALLINT" nil false)
		'("TYPE_NAME" "NVARCHAR" 128 false) '("PRECISION" "INT" nil true) '("LENGTH" "INT" nil true) '("SCALE" "SMALLINT" nil true)
		'("RADIX" "SMALLINT" nil true) '("NULLABLE" "SMALLINT" nil false) '("REMARKS" "VARCHAR" 254 true)
		'("COLUMN_DEF" "NVARCHAR" 4000 true) '("SQL_DATA_TYPE" "SMALLINT" nil false) '("SQL_DATETIME_SUB" "SMALLINT" nil true)
		'("CHAR_OCTET_LENGTH" "INT" nil true) '("ORDINAL_POSITION" "INT" nil false) '("IS_NULLABLE" "VARCHAR" 254 false)
		'("SS_DATA_TYPE" "TINYINT" nil true)))
		"rows" (merge (map (sort (filter (merge (show schema) (tsql_odbc_view_names schema)) (lambda (name) (and (tsql_odbc_matches "dbo" owner true) (tsql_odbc_matches name table_name true)))) <)
			(lambda (name) (filter (mapIndex (filter (tsql_odbc_object_columns schema name session) (lambda (col) (not (internal_column_name? (col "Field"))))) (lambda (ordinal col) (begin
				(define declared (coalesceNil (col "SQLDeclaredType") ""))
				(define type (toUpper (if (equal? declared "") (col "RawType") declared)))
				(define info (tsql_odbc_type type (col "Dimensions") version))
				(define alias (find (sql_type_aliases schema) (lambda (alias) (equal? (alias "ID") (col "SQLAliasID"))) nil))
				(list "TABLE_QUALIFIER" schema "TABLE_OWNER" "dbo" "TABLE_NAME" name "COLUMN_NAME" (col "Field")
					"DATA_TYPE" (info "code") "TYPE_NAME" (concat (if alias (alias "Name") (toLower type)) (if (equal? (col "Extra") "auto_increment") " identity" ""))
					"PRECISION" (info "precision") "LENGTH" (info "length") "SCALE" (info "scale") "RADIX" (info "radix")
					"NULLABLE" (if (col "Null") 1 0) "REMARKS" nil "COLUMN_DEF" nil "SQL_DATA_TYPE" (info "sql_code")
					"SQL_DATETIME_SUB" (info "temporal") "CHAR_OCTET_LENGTH" (info "octets") "ORDINAL_POSITION" (+ ordinal 1)
					"IS_NULLABLE" (if (col "Null") "YES" "NO") "SS_DATA_TYPE" (get_assoc tsql_native_type_ids (toLower type))))))
				(lambda (row) (tsql_odbc_matches (row "COLUMN_NAME") column_name true)))))))))
)
(define tsql_odbc_datatype_row (lambda (type dimensions version) (begin
	(define info (tsql_odbc_type type dimensions version))
	(define textual (has? '("CHAR" "VARCHAR" "NCHAR" "NVARCHAR" "TEXT" "NTEXT") type))
	(define binary (has? '("BINARY" "VARBINARY" "ROWVERSION") type))
	(define temporal (has? '("DATE" "TIME" "DATETIME" "DATETIME2" "SMALLDATETIME") type))
	(define numerical (not (or textual binary temporal)))
	(list "TYPE_NAME" (toLower type) "DATA_TYPE" (info "code") "PRECISION" (info "precision")
		"LITERAL_PREFIX" (if (or textual temporal) "'" (if binary "0x" nil)) "LITERAL_SUFFIX" (if (or textual temporal) "'" nil)
		"CREATE_PARAMS" (if (has? '("CHAR" "VARCHAR" "NCHAR" "NVARCHAR" "BINARY" "VARBINARY") type) "length"
			(if (has? '("DECIMAL" "NUMERIC") type) "precision,scale" (if (has? '("TIME" "DATETIME2") type) "scale" nil)))
		"NULLABLE" 1 "CASE_SENSITIVE" 0 "SEARCHABLE" (if (has? '("TEXT" "NTEXT") type) 1 3)
		"UNSIGNED_ATTRIBUTE" (if numerical (if (has? '("TINYINT" "BIT") type) 1 0) nil)
		"MONEY" (if (has? '("MONEY" "SMALLMONEY") type) 1 0) "AUTO_INCREMENT" (if (has? '("INT" "BIGINT" "SMALLINT" "TINYINT") type) 1 0)
		"LOCAL_TYPE_NAME" (toLower type) "MINIMUM_SCALE" (if (nil? (info "scale")) nil (if (has? '("MONEY" "SMALLMONEY" "DATETIME") type) (info "scale") 0))
		"MAXIMUM_SCALE" (info "scale") "SQL_DATA_TYPE" (info "sql_code") "SQL_DATETIME_SUB" (info "temporal")
		"NUM_PREC_RADIX" (info "radix") "INTERVAL_PRECISION" nil "USERTYPE" (get_assoc tsql_native_type_ids (toLower type))))))
(define tsql_odbc_datatypes (lambda (schema params) (begin
	(define names '("data_type" "odbcver"))
	(tsql_odbc_validate_arguments params names)
	(define data_type (tsql_odbc_argument params names "data_type" 0))
	(define version (tsql_odbc_argument params names "odbcver" 2))
	(if (has? '(2 3) version) true (error "ODBC metadata version must be 2 or 3"))
	(define declarations (list (list "BIGINT" '()) (list "BINARY" '(8000)) (list "BIT" '()) (list "CHAR" '(8000))
		(list "DATE" '()) (list "DATETIME" '()) (list "DATETIME2" '(7)) (list "DECIMAL" '(38 38)) (list "FLOAT" '())
		(list "INT" '()) (list "MONEY" '()) (list "NCHAR" '(4000)) (list "NTEXT" '()) (list "NUMERIC" '(38 38))
		(list "NVARCHAR" '(4000)) (list "REAL" '()) (list "SMALLINT" '()) (list "SMALLMONEY" '())
		(list "SMALLDATETIME" '()) (list "TEXT" '()) (list "TIME" '(7)) (list "TINYINT" '())
		(list "VARBINARY" '(8000)) (list "VARCHAR" '(8000))))
	(define rows (map declarations (lambda (declaration) (tsql_odbc_datatype_row (car declaration) (cadr declaration) version))))
	(list "fields" (tsql_odbc_fields '( '("TYPE_NAME" "NVARCHAR" 128 false) '("DATA_TYPE" "SMALLINT" nil false) '("PRECISION" "INT" nil true) '("LITERAL_PREFIX" "VARCHAR" 32 true) '("LITERAL_SUFFIX" "VARCHAR" 32 true) '("CREATE_PARAMS" "VARCHAR" 32 true) '("NULLABLE" "SMALLINT" nil false) '("CASE_SENSITIVE" "SMALLINT" nil false) '("SEARCHABLE" "SMALLINT" nil false) '("UNSIGNED_ATTRIBUTE" "SMALLINT" nil true) '("MONEY" "SMALLINT" nil false) '("AUTO_INCREMENT" "SMALLINT" nil true) '("LOCAL_TYPE_NAME" "NVARCHAR" 128 true) '("MINIMUM_SCALE" "SMALLINT" nil true) '("MAXIMUM_SCALE" "SMALLINT" nil true) '("SQL_DATA_TYPE" "SMALLINT" nil false) '("SQL_DATETIME_SUB" "SMALLINT" nil true) '("NUM_PREC_RADIX" "INT" nil true) '("INTERVAL_PRECISION" "SMALLINT" nil true) '("USERTYPE" "SMALLINT" nil true)))
		"rows" (sort (filter rows (lambda (row) (or (equal? data_type 0) (equal? (row "DATA_TYPE") data_type))))
			(lambda (a b) (if (equal? (a "DATA_TYPE") (b "DATA_TYPE")) (< (a "TYPE_NAME") (b "TYPE_NAME")) (< (a "DATA_TYPE") (b "DATA_TYPE")))))))))
/* Parameter discovery examines neutral SELECT expressions. Unknown contexts
fail explicitly; the query is never evaluated or physically lowered. */
(define tsql_metadata_parameter (lambda (expression) (match expression
	((symbol if) ((symbol session) bound) ((symbol session) key) ((symbol error) message))
	(if (and (strlike key "tsql_param:%") (equal? bound (concat "tsql_bound:" (substr key 11))))
		(list (substr key 11) (substr message 25)) nil)
	_ nil)))
(define tsql_metadata_declaration (lambda (schema spec) (begin
	(define alias (sql_type_alias schema (car spec)))
	(if alias (list "type" (alias "BaseType") "dimensions" (alias "Dimensions") "alias" alias)
		(list "type" (if (equal? (car spec) "INTEGER") "INT" (car spec)) "dimensions" (cadr (tsql_native_type spec)) "alias" nil)))))
(define tsql_metadata_column (lambda (schema sources expression declarations) (match expression
	((symbol get_column) alias _ name _) (begin
		(define columns (merge (map sources (lambda (source)
			(if (and (or (nil? alias) (equal?? alias (source_alias source))) (string? (source_relation source)))
				(filter (tsql_get_schema (source_schema source) (source_relation source)) (lambda (column) (equal?? (column "Field") name))) '())))))
		(if (> (count columns) 1) (error "ambiguous parameter comparison column") true)
		(if (empty_list? columns) nil (begin
			(define column (car columns))
			(define declared (coalesceNil (column "SQLDeclaredType") ""))
			(define type (toUpper (if (equal? declared "") (column "RawType") declared)))
			(define alias_type (find (sql_type_aliases schema) (lambda (candidate) (equal? (candidate "ID") (column "SQLAliasID"))) nil))
			(list "type" (if (has? '("ROWVERSION" "TIMESTAMP") type) "BINARY" type) "dimensions" (column "Dimensions") "alias" alias_type))))
	((symbol tsql_cast_value) _ ((symbol quote) spec)) (tsql_metadata_declaration schema spec)
	((symbol tsql_cast_bound) _ _source ((symbol quote) spec)) (tsql_metadata_declaration schema spec)
	((symbol tsql_convert_bound) _ _source ((symbol quote) spec) _style) (tsql_metadata_declaration schema spec)
	_ (begin (define parameter (tsql_metadata_parameter expression))
		(if parameter (get_assoc declarations (car parameter)) nil)))))
(define tsql_odbc_object_columns (lambda (schema name session) (begin
	(define view (sql_find_view schema name))
	(if (nil? view) (tsql_get_schema schema name) (begin
		(define query (normalize_query_ast (sql_expand_views (json_decode_scmer (nth view 2)) (sql_policy (session "username")))))
		(if (query_block? query) true (error "view column metadata currently requires one query block"))
		(merge (extract_assoc (expand_query_block_fields (qb_sources query) (qb_fields query)) (lambda (name expression) (begin
			(define description (tsql_metadata_column schema (qb_sources query) expression '()))
			(if description true (error "view expression type is unknown"))
			(define alias (description "alias"))
			(list (list "Field" name "RawType" (description "type") "SQLDeclaredType" (description "type")
				"Dimensions" (description "dimensions") "Null" true "SQLAliasID" (if alias (alias "ID") 0))))))))))))
(define tsql_metadata_constraints (lambda (schema node sources expected declarations) (begin
	(define parameter (tsql_metadata_parameter node))
