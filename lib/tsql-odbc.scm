		(match node
			((symbol query-block) _ local_sources fields condition group having ordering limit offset _hidden _stages _facts)
			(begin
				(map local_sources (lambda (source)
					(if (and (string? (source_relation source)) (not (tsql_catalog_database (source_schema source))))
						(if (table (source_schema source) (source_relation source)) true (error "unknown table in parameter description")) true)))
				(merge (merge (map local_sources (lambda (source)
					(merge (if (string? (source_relation source)) '() (tsql_metadata_constraints schema (source_relation source) '() nil declarations))
						(tsql_metadata_constraints schema (source_join_expr source) local_sources nil declarations)))))
					(merge (map (list fields condition group having ordering limit offset) (lambda (part)
						(tsql_metadata_constraints schema part local_sources nil declarations))))))
			((symbol get_column) _alias _case _name _name_case)
			(if (tsql_metadata_column schema sources node declarations) '() (error "unsupported or unknown column in parameter description"))
			((symbol union-block) _ branches _order _limit _offset _facts)
			(merge (map branches (lambda (part) (tsql_metadata_constraints schema part sources nil declarations))))
			((symbol tsql_cast_bound) input _source ((symbol quote) spec))
			(tsql_metadata_constraints schema input sources (tsql_metadata_declaration schema spec) declarations)
			((symbol tsql_convert_bound) input _source ((symbol quote) spec) _style)
			(tsql_metadata_constraints schema input sources (tsql_metadata_declaration schema spec) declarations)
			((symbol tsql_cast_value) input ((symbol quote) spec))
			(tsql_metadata_constraints schema input sources (tsql_metadata_declaration schema spec) declarations)
			((symbol tsql_convert_value) input ((symbol quote) spec) _style _source_type)
			(tsql_metadata_constraints schema input sources (tsql_metadata_declaration schema spec) declarations)
			((symbol tsql_compare_bound) _operator left right _left_spec _right_spec)
			(merge (tsql_metadata_constraints schema left sources (tsql_metadata_column schema sources right declarations) declarations)
				(tsql_metadata_constraints schema right sources (tsql_metadata_column schema sources left declarations) declarations))
			(cons operator '(left right))
			(if (has? '(equal?? < > <= >=) operator)
				(merge (tsql_metadata_constraints schema left sources (tsql_metadata_column schema sources right declarations) declarations)
					(tsql_metadata_constraints schema right sources (tsql_metadata_column schema sources left declarations) declarations))
				(merge (map (list left right) (lambda (part) (tsql_metadata_constraints schema part sources nil declarations)))))
			((symbol quote) _value) '()
			(cons _head rest) (merge (map rest (lambda (part) (tsql_metadata_constraints schema part sources nil declarations))))
			_ '())))))
(define tsql_metadata_declared_parameters (lambda (schema text)
	(if (or (nil? text) (equal? text "")) '()
		(merge (map (tsql_parse_declarations text schema) (lambda (entry)
			(list (car entry) (tsql_metadata_declaration schema (cadr entry)))))))))
