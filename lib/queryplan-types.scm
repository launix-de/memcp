/* SQL expression compilation returns (formula type collation). Collation is
(name coercibility), or nil for non-text results. Only value-producing operands
participate in type aggregation: CASE predicates and substring offsets do not.
Descriptors are resolved before relational rewrites; ORDER and comparisons use
canonical collate callbacks, and result descriptors survive in the IR context. */
(define sql_collation (lambda (value collation) value))
(define sql_collated_in (lambda (values value less)
	(if (nil? value) nil
		(reduce values (lambda (found candidate)
			(if (equal? found true) true
				(if (nil? candidate) nil
					(if (and (not (less value candidate)) (not (less candidate value))) true found)))) false))))

(define sql_cast_value (lambda (value type)
	(if (nil? value) nil
		(if (sql_text_type? type) (concat value)
			(if (equal? type "BIGINT") (intdiv (simplify value) 1) (simplify value))))))
(define sql_typed_value (lambda (value type collation) value))
(define sql_parameter_value (lambda (value type collation) value))
(define sql_info_formula car)
(define sql_info_type cadr)
(define sql_info_collation (lambda (info) (nth info 2)))
(define sql_info (lambda (formula type collation) (list formula type collation)))
(define sql_text_type? (lambda (type)
	(has? '("CHAR" "VARCHAR" "TEXT" "TINYTEXT" "MEDIUMTEXT" "LONGTEXT" "ENUM" "SET" "BINARY" "VARBINARY" "BLOB" "TINYBLOB" "MEDIUMBLOB" "LONGBLOB") type)))
(define sql_numeric_type? (lambda (type)
	(has? '("BOOL" "BOOLEAN" "INT" "INTEGER" "BIGINT" "SMALLINT" "TINYINT" "MEDIUMINT" "BIT" "DECIMAL" "NUMERIC" "FLOAT" "DOUBLE" "REAL") type)))
(define sql_collation_name (lambda (info)
	(if (nil? (sql_info_collation info)) "bin" (car (sql_info_collation info)))))

(define sql_merge_collation (lambda (a b)
	(if (nil? a) b (if (nil? b) a
		(if (equal? (car a) (car b)) (list (car a) (min (cadr a) (cadr b)))
			(if (< (cadr a) (cadr b)) a (if (> (cadr a) (cadr b)) b
				(if (equal? (cadr a) 0) (error "Illegal mix of explicit collations")
					(if (or (equal? (car a) "bin") (strlike (car a) "%_bin")) a
						(if (or (equal? (car b) "bin") (strlike (car b) "%_bin")) b
							(error "Illegal mix of collations")))))))))))

(define sql_merge_info (lambda (a b)
	(sql_info nil
		(if (equal? (sql_info_type a) "NULL") (sql_info_type b)
			(if (equal? (sql_info_type b) "NULL") (sql_info_type a)
				(if (equal? (sql_info_type a) (sql_info_type b)) (sql_info_type a)
					(if (or (sql_text_type? (sql_info_type a)) (sql_text_type? (sql_info_type b))) "VARCHAR"
						(if (or (equal? (sql_info_type a) "DOUBLE") (equal? (sql_info_type b) "DOUBLE")) "DOUBLE"
							(if (and (sql_numeric_type? (sql_info_type a)) (sql_numeric_type? (sql_info_type b))) "DECIMAL" "VARCHAR"))))))
		(sql_merge_collation (sql_info_collation a) (sql_info_collation b)))))
(define sql_merge_infos (lambda (infos)
	(reduce infos sql_merge_info (sql_info nil "NULL" nil))))

(define sql_source_column_info (lambda (src col)
	(if (source_is_base_table? src)
		(begin
			(define meta (find (get_schema (source_schema src) (source_relation src))
				(lambda (entry) (equal?? (entry "Field") col)) nil))
			(define type (toUpper (coalesceNil (if (nil? meta) nil (meta "RawType")) "UNKNOWN")))
			(sql_info nil type (if (sql_text_type? type)
				(list (coalesceNil (if (nil? meta) nil (meta "Collation")) "bin") 2) nil)))
		(begin
			(define fields (sql_query_result_infos (normalize_query_ast (source_relation src))))
			(coalesceNil (get_assoc fields col) (sql_info nil "VARCHAR" (list "bin" 2)))))))

(define sql_case_values (lambda (args)
	(match args
		'(last) (list last)
		(cons _condition (cons value rest)) (cons value (sql_case_values rest))
		_ '())))

/* Function objects in the SQL builtin registry retain their SQL return contract.
The parser may use named runtime operators or registered function values. */
(define sql_function_rule (lambda (head)
	(coalesceNil (find (sql_function_rules) (lambda (entry)
		(or (equal? head (car entry))
			(and (symbol? head) (equal? (string head) (string (car entry)))))) nil)
		(list head "VARCHAR" "default"))))

(define sql_expr_info (lambda (sources expr)
	(match expr
		((symbol get_column) alias _ic col _cic)
		(begin
			(define src (find sources (lambda (src) (or (nil? alias) (equal?? alias (source_alias src)))) nil))
			(define info (if (nil? src) (sql_info nil "VARCHAR" (list "bin" 2)) (sql_source_column_info src col)))
			(sql_info expr (sql_info_type info) (sql_info_collation info)))
		((symbol sql_collation) value collation)
		(begin
			(define info (sql_expr_info sources value))
			(sql_info (list (quote sql_collation) (car info) collation) (cadr info) (list collation 0)))
		((symbol sql_temporal_output) value type timezone)
		(sql_info (list (quote sql_temporal_output) (car (sql_expr_info sources value)) type timezone) type nil)
		((symbol sql_parameter_value) value type collation)
		(sql_info expr type (if (nil? collation) nil (list collation 4)))
		((symbol sql_typed_value) value type collation)
		(sql_info (list (quote sql_typed_value) (sql_info_formula (sql_expr_info sources value)) type collation) type
			(if (nil? collation) nil (list collation 2)))
		((symbol inner_select_exists) query)
		(sql_info (list (quote inner_select_exists) (sql_type_query query sources)) "BOOLEAN" nil)
		((symbol inner_select_in) probe query)
		(sql_info (list (quote inner_select_in) (car (sql_expr_info sources probe)) (sql_type_query query sources)) "BOOLEAN" nil)
		((symbol inner_select) query)
		(begin
			(define typed (sql_type_query query sources))
			(define infos (sql_query_result_infos typed))
			(define info (if (empty_list? infos) (sql_info nil "NULL" nil) (cadr infos)))
			(sql_info (list (quote inner_select) typed) (sql_info_type info) (sql_info_collation info)))
		((symbol window_func) name args spec)
		(begin
			(define infos (map args (lambda (arg) (sql_expr_info sources arg))))
			(define first (if (empty_list? infos) (sql_info nil "BIGINT" nil) (car infos)))
			(define type (if (has? '("ROW_NUMBER" "RANK" "DENSE_RANK" "COUNT" "NTILE") name) "BIGINT"
				(if (has? '("SUM" "AVG") name) "DECIMAL" (cadr first))))
			(define typed_spec (list (map (car spec) (lambda (key) (car (sql_expr_info sources key))))
				(map (cadr spec) (lambda (item) (begin
					(define info (sql_expr_info sources (car item)))
					(list (car info) (if (or (equal? (cadr item) <) (equal? (cadr item) >))
						(collate (sql_collation_name info) (equal? (cadr item) >)) (cadr item))))))))
			(sql_info (list (quote window_func) name (map infos car) typed_spec) type
				(if (sql_text_type? type) (sql_info_collation first) nil)))
		((symbol group_concat_distinct) value separator)
		(begin
			(define info (sql_expr_info sources value))
			(sql_info (list (quote aggregate) (car info) (quote sql_distinct_accumulate) (list (quote list))
				(list (quote lambda) (list (quote values))
					(list (quote reduce) (list (quote sql_distinct_values) (quote values) (collate (sql_collation_name info) false))
						(list (quote lambda) (list (quote acc) (quote value))
							(list (quote if) (list (quote nil?) (quote acc)) (list (quote concat) (quote value))
								(list (quote concat) (quote acc) separator (quote value)))) nil)))
				"VARCHAR" (sql_info_collation info)))
		((symbol count_distinct) value)
		(begin
			(define info (sql_expr_info sources value))
			(sql_info (list (quote aggregate) (car info) (quote sql_distinct_accumulate) (list (quote list))
				(list (quote lambda) (list (quote values))
					(list (quote count) (list (quote sql_distinct_values) (quote values) (collate (sql_collation_name info) false)))))
				"BIGINT" nil))
		((symbol aggregate) value reducer neutral)
		(begin
			(define info (sql_expr_info sources value))
			(define preserve (or (equal? reducer min) (equal? reducer max) (equal? reducer (quote min)) (equal? reducer (quote max))))
			(define typed_reducer (if (and preserve (sql_text_type? (cadr info)))
				(list (quote lambda) (list (quote left) (quote right))
					(list (quote if) (list (quote nil?) (quote left)) (quote right)
						(list (quote nil?) (quote right)) (quote left)
						(list (collate (sql_collation_name info) (or (equal? reducer max) (equal? reducer (quote max)))) (quote left) (quote right))
						(quote left) (quote right))) reducer))
			(sql_info (list (quote aggregate) (car info) typed_reducer neutral)
				(if preserve (cadr info) (if (and (equal? value 1) (equal? neutral 0)) "BIGINT"
					(if (sql_text_type? (cadr info)) "VARCHAR" "DECIMAL")))
				(if (or preserve (sql_text_type? (cadr info))) (sql_info_collation info) nil)))
		((symbol sql_in) values value)
		(begin
			(define input (sql_expr_info sources value))
			(define infos (map (cdr values) (lambda (item) (sql_expr_info sources item))))
			(if (and (sql_text_type? (cadr input))
				(reduce infos (lambda (ok info) (and ok (or (equal? (cadr info) "NULL") (sql_text_type? (cadr info))))) true))
				(sql_info (list (quote sql_collated_in) (cons (car values) (map infos car)) (car input)
					(collate (sql_collation_name (sql_merge_infos (cons input infos))) false)) "BOOLEAN" nil)
				(sql_info (list (quote sql_in) (cons (car values) (map infos car)) (car input)) "BOOLEAN" nil)))
		((symbol strlike) value pattern collation)
		(begin
			(define input (sql_expr_info sources value))
			(sql_info (list (quote strlike) (car input) (car (sql_expr_info sources pattern))
				(if (nil? (sql_info_collation input)) collation (sql_collation_name input))) "BOOLEAN" nil))
		((symbol quote) value) (sql_info expr "VARCHAR" nil)
		((symbol lambda) _params _body) (sql_info expr "VARCHAR" nil)
		((symbol aggregate) value reducer neutral finalize)
		(begin
			(define info (sql_expr_info sources (list (quote aggregate) value reducer neutral)))
			(define result (sql_expr_info sources (if (and (list? finalize) (equal? (car finalize) (quote lambda)))
				(nth finalize 2) (list finalize nil))))
			(sql_info (list (quote aggregate) (cadr (car info)) reducer neutral finalize) (cadr result) (sql_info_collation result)))
		(cons head args)
		(begin
			(define infos (map args (lambda (arg) (sql_expr_info sources arg))))
			(define formula (cons head (map infos car)))
			(define rule (sql_function_rule head))
			(define mode (nth rule 2))
			(define values (if (equal? mode "case") (sql_case_values infos)
				(if (equal? mode "first") (slice infos 0 (min 1 (count infos))) infos)))
			(define combined (if (has? '("case" "first" "merge" "text") mode) (sql_merge_infos values) (sql_info nil (cadr rule) nil)))
			(define type (if (has? '("case" "merge") mode) (sql_info_type combined) (cadr rule)))
			(define collation (if (sql_text_type? type)
				(coalesceNil (sql_info_collation combined) (list "utf8mb4_unicode_520_ci" 4)) nil))
			(define coerced (if (and (has? '("case" "merge") mode) (sql_text_type? type)
				(reduce values (lambda (needed info) (or needed (sql_numeric_type? (cadr info)))) false))
				(if (equal? mode "case")
					(cons head (sql_coerce_case_args infos type))
					(cons head (map infos (lambda (info) (sql_coerce_info info type))))) formula))
			(sql_info (sql_compile_comparison head infos coerced) type collation))
		_ (sql_info expr
			(if (nil? expr) "NULL" (if (string? expr) "VARCHAR" (if (number? expr) (if (equal? expr (floor expr)) "BIGINT" "DOUBLE") (if (or (equal? expr true) (equal? expr false)) "BOOLEAN" "VARCHAR"))))
			(if (string? expr) (list "utf8mb4_unicode_520_ci" 4) nil)))))

/* SQL NULL handling surrounds the canonical Less relation. The compiler emits
this named scalar primitive so physical scan lowering can also derive bounds. */
(define sql_compare (lambda (left right less operator collation)
	(if (or (nil? left) (nil? right)) nil
		(match operator
			"equal??" (and (not (less left right)) (not (less right left)))
			"<" (less left right)
			">" (less right left)
			"<=" (not (less right left))
			">=" (not (less left right))
			_ (error "unsupported SQL comparison")))))

(define sql_compile_comparison (lambda (head infos formula)
	(if (and (has? (list (quote equal??) (quote <) (quote >) (quote <=) (quote >=)) head) (equal? (count infos) 2)
		(and (sql_text_type? (cadr (car infos))) (sql_text_type? (cadr (cadr infos)))))
		(list (quote sql_compare) (car (car infos)) (car (cadr infos))
			(collate (sql_collation_name (sql_merge_infos infos)) false) (string head)
			(sql_collation_name (sql_merge_infos infos)))
		formula)))

(define sql_merge_result_infos (lambda (left right)
	(match left
		(cons title (cons info rest)) (match right
			(cons _title (cons other remaining))
			(cons title (cons (sql_merge_info info other) (sql_merge_result_infos rest remaining)))
			_ (error "UNION branch column count mismatch"))
		_ (if (empty_list? right) '() (error "UNION branch column count mismatch")))))

(define sql_query_result_infos (lambda (query)
	(if (query_block? query)
		(coalesceNil (qassoc_get (qb_facts query) (quote result-types) nil)
			(map_assoc (expand_query_block_fields (qb_sources query) (qb_fields query))
				(lambda (_title expr) (sql_expr_info (qb_sources query) expr))))
		(if (union_block? query)
			(coalesceNil (qassoc_get (union_facts query) (quote result-types) nil) '()) '()))))

(define sql_type_query (lambda (query outer_sources)
	(if (query_block? query)
		(begin
			(define sources (map (qb_sources query) (lambda (src)
				(source_with_relation src (sql_type_query (source_relation src) outer_sources)))))
			(define all_sources (merge (list sources outer_sources)))
			(define compile (lambda (expr) (sql_expr_info all_sources expr)))
			(define fields (map_assoc (expand_query_block_fields sources (qb_fields query)) (lambda (_title expr) (compile expr))))
			(make_query_block (qb_schema query)
				(map sources (lambda (src) (source_with_join_expr src (car (compile (source_join_expr src))))))
				(map_assoc fields (lambda (_title info) (car info)))
				(car (compile (qb_where query)))
				(map (qb_group query) (lambda (expr) (car (compile expr))))
				(car (compile (qb_having query)))
				(map (coalesceNil (qb_order query) '()) (lambda (item) (begin
					(define info (compile (car item)))
					(list (car info) (if (or (equal? (cadr item) <) (equal? (cadr item) >))
						(collate (sql_collation_name info) (equal? (cadr item) >)) (cadr item))))))
				(qb_limit query) (qb_offset query) (qb_hidden query) (qb_stages query)
				(qassoc_set (qb_facts query) (quote result-types)
					(map_assoc fields (lambda (_title info) (sql_info nil (cadr info) (sql_info_collation info)))))))
		(if (union_block? query)
			(begin
				(define branches (map (union_branches query) (lambda (branch) (sql_type_query branch outer_sources))))
				(define fields (if (empty_list? branches) '() (sql_query_result_infos (car branches))))
				(define merged (reduce (cdr branches) (lambda (fields branch)
					(sql_merge_result_infos fields (sql_query_result_infos branch))) fields))
				(make_union_block (union_mode query) (map branches (lambda (branch) (sql_union_coerce_branch branch merged))) (union_order query) (union_limit query) (union_offset query)
					(qassoc_set (union_facts query) (quote result-types) merged)))
			query))))

