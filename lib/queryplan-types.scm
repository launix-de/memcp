(define sql_function_rules (lambda ()
	(if (or (nil? sql_builtins) (symbol? sql_builtins)) sql_core_function_rules (sql_cached_function_rules))))

/* Group raw spellings within each shard first, then merge collation-equivalent
keys in one sorted batch. The existing Less factory remains the only authority;
no lowercasing, accent stripping or alternate equality is introduced. */
(define sql_tuple_less (lambda (left right relations)
	(match relations
		(cons less rest) (begin
			(define a (car left))
			(define b (car right))
			(if (and (nil? a) (nil? b)) (sql_tuple_less (cdr left) (cdr right) rest)
				(if (nil? a) true (if (nil? b) false
					(if (less a b) true (if (less b a) false
						(sql_tuple_less (cdr left) (cdr right) rest)))))))
		_ false)))

(define sql_merge_collated_groups (lambda (groups relations combine)
	(begin
		(define ordered (sort (extract_assoc groups (lambda (key payload) (list key payload)))
			(lambda (a b) (sql_tuple_less (car a) (car b) relations))))
		(define merged (reduce ordered (lambda (acc pair)
			(if (empty_list? acc) (list pair)
				(if (or (sql_tuple_less (car (car acc)) (car pair) relations)
					(sql_tuple_less (car pair) (car (car acc)) relations))
					(cons pair acc)
					(cons (list (car (car acc)) (combine (cadr (car acc)) (cadr pair))) (cdr acc))))) '()))
		(merge (reverse merged)))))

(define sql_distinct_accumulate (lambda (a b)
	(merge_unique (list (if (list? a) a (if (nil? a) '() (list a)))
		(if (list? b) b (if (nil? b) '() (list b)))))))
(define sql_distinct_values (lambda (values less)
	(map (extract_assoc
		(sql_merge_collated_groups
			(merge (map (filter values (lambda (value) (not (nil? value))))
				(lambda (value) (list (list value) true))))
			(list less) (lambda (a b) true))
		(lambda (key _value) key)) car)))

(define sql_group_equal (lambda (left right less)
	(if (nil? left) (nil? right) (if (nil? right) false
		(and (not (less left right)) (not (less right left)))))))

(define sql_coerce_info (lambda (info type)
	(if (or (equal? (cadr info) type) (equal? (cadr info) "NULL")) (car info)
		(list (quote sql_cast_value) (car info) type))))
(define sql_coerce_case_args (lambda (infos type)
	(match infos
		'(last) (list (sql_coerce_info last type))
		(cons condition (cons value rest)) (cons (car condition) (cons (sql_coerce_info value type) (sql_coerce_case_args rest type)))
		_ '())))

(define sql_union_coerce_fields (lambda (fields own target)
	(match fields
		(cons title (cons expr rest)) (begin
			(define info (cadr own))
			(define result (cadr target))
			(define converted (sql_coerce_info (sql_info expr (cadr info) (sql_info_collation info)) (cadr result)))
			(cons title (cons
				(if (and (equal? converted expr) (equal? (sql_info_collation info) (sql_info_collation result))) expr
					(list (quote sql_typed_value) converted (cadr result)
						(if (nil? (sql_info_collation result)) nil (sql_collation_name result))))
				(sql_union_coerce_fields rest (cdr (cdr own)) (cdr (cdr target))))))
		_ '())))
(define sql_union_coerce_branch (lambda (branch target)
	(if (query_block? branch)
		(make_query_block (qb_schema branch) (qb_sources branch)
			(sql_union_coerce_fields (qb_fields branch) (sql_query_result_infos branch) target)
			(qb_where branch) (qb_group branch) (qb_having branch) (qb_order branch)
			(qb_limit branch) (qb_offset branch) (qb_hidden branch) (qb_stages branch) (qb_facts branch))
		branch)))

/* Bind-variable values are request-local. Specialize only their SQL type and
record that type as a cache guard; the generated formula still reads the session.
No row sampling or captured request value enters the result contract. */
(define sql_runtime_value_type (lambda (value)
	(if (nil? value) "NULL" (if (int? value) "BIGINT" (if (number? value) "DOUBLE"
		(if (string? value) "VARCHAR" (if (or (equal? value true) (equal? value false)) "BOOLEAN" "VARCHAR")))))))
(define sql_bind_expression_types (lambda (expr planning_session)
	(if (nil? planning_session) expr
		(match expr
			((symbol quote) _value) expr
			((symbol session) key)
			(if (and (string? key) (not (strlike key "__memcp%")))
				(begin
					(define type (sql_runtime_value_type (planning_session key)))
					(planner_record_guard_condition
						(list (quote equal?) (list (quote sql_runtime_value_type) expr) type) planning_session)
					(list (quote sql_parameter_value) expr type
						(if (sql_text_type? type) "utf8mb4_unicode_520_ci" nil))) expr)
			(cons head tail) (cons (sql_bind_expression_types head planning_session)
				(map tail (lambda (item) (sql_bind_expression_types item planning_session))))
			_ expr))))

(define sql_resultfields_expr (lambda (infos)
	(list (quote resultfields) (list (quote quote) (extract_assoc infos (lambda (title info)
		(list title (sql_info_type info) (sql_collation_name info))))))))
