/* TSQL lexemes own their token boundary. A numeric token can directly precede
an identifier or keyword; a keyword cannot be a prefix of a regular identifier.
The generic scanner's letter/digit word boundary does not express that rule.
Capture supplies ordinary leading trivia without adding a word-boundary check;
the raw atom and this continuation exclusion consume only the actual lexeme.
https://learn.microsoft.com/sql/relational-databases/databases/database-identifiers
SQL Server 2022 reference: https://dbfiddle.uk/kjteBcOH */
(define tsql_identifier_continue_pattern "[\\p{L}\\p{Nl}\\p{Nd}\\p{Mn}\\p{Mc}\\p{Pc}\\p{Cf}@$#]")
(define tsql_keyword_parser (lambda (word)
	(eval (list 'parser
		(list 'define 'token (list 'capture (list 'not
			(list 'atom word true false)
			(list 'regex (concat word tsql_identifier_continue_pattern) true false))))
		(list 'cadr 'token)))))

/* These immutable grammar bindings share one lexical policy.
Their values preserve the grammar's declared spelling. */
