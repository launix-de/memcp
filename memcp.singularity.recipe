Bootstrap: docker
From: alpine:3.22

%files
	memcp /app/memcp
	lib /app/lib
	assets /app/assets
	packaging/docker-entrypoint.sh /usr/local/bin/memcp-entrypoint

%post
	apk add --no-cache ca-certificates
	chmod 0755 /app/memcp /usr/local/bin/memcp-entrypoint
	mkdir -p /data

%environment
	export MEMCP_DATA_DIR=/data
	export MEMCP_ROOT_PASSWORD_FILE=/run/secrets/memcp_root_password

%runscript
	if [ "$#" -eq 0 ]; then
		set -- lib/main.scm
	fi
	exec /usr/local/bin/memcp-entrypoint "$@"
