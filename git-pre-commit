# MemCP Pre-commit Hook
# Runs SQL tests before allowing commits using a single MemCP instance
#

echo "🔍 Running MemCP pre-commit tests..."

if ! python3 tools/check_sql_time_limit.py; then
  echo "❌ SQL and planner regression guards failed, commit aborted"
  exit 1
fi

if ! python3 tools/test_sql_time_limit_guard.py; then
  echo "❌ SQL regression guard tests failed, commit aborted"
  exit 1
fi

if ! python3 tools/test_sql_runner_contract.py; then
  echo "❌ SQL runner contract tests failed, commit aborted"
  exit 1
fi

if ! python3 tools/check_test_table_names.py; then
  echo "❌ Test fixture table names collide across CI suites"
  exit 1
fi

fail_fast_mode="${MEMCP_FAIL_FAST:-1}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fail-fast)
      fail_fast_mode=1
      shift
      ;;
    --no-fail-fast)
      fail_fast_mode=0
      shift
      ;;
    *)
      break
      ;;
  esac
done

# Global state for reliable cleanup
did_cleanup=0
active_pids=()

# Build memcp to ensure latest changes are included
echo "🔨 Building memcp..."
build_flags=""
if [ "${MEMCP_COVERAGE:-}" = "1" ]; then
    build_flags="-cover"
    export GOCOVERDIR="${MEMCP_COVERDIR:-/tmp/memcp-coverage}"
    rm -rf "$GOCOVERDIR"
    mkdir -p "$GOCOVERDIR"
    echo "📊 Coverage mode enabled (GOCOVERDIR=$GOCOVERDIR)"
fi
if ! go build $build_flags -o memcp; then
    echo "❌ Build failed, commit aborted"
    exit 1
fi

# Calibrate fixed, engine-independent CPU work before MemCP starts.  Every
# suite process inherits this one machine factor, so a MemCP regression cannot
# slow the calibrator and thereby enlarge its own wall-clock allowance.
read -r performance_arch performance_scale performance_measured_ns performance_reference_ns < <(
  python3 - <<'PY'
from run_sql_tests import calibrate_performance_scale

calibration = calibrate_performance_scale()
print(
    calibration["architecture"],
    format(calibration["scale"], ".17g"),
    calibration["measured_ns"],
    calibration["reference_ns"],
)
PY
)
if [ -z "$performance_scale" ]; then
  echo "❌ Performance calibration failed, commit aborted"
  exit 1
fi
export MEMCP_TEST_PERFORMANCE_ARCH="$performance_arch"
export MEMCP_TEST_PERFORMANCE_SCALE="$performance_scale"
export MEMCP_TEST_PERFORMANCE_MEASURED_NS="$performance_measured_ns"
export MEMCP_TEST_PERFORMANCE_REFERENCE_NS="$performance_reference_ns"
echo "⚖️  Wall-clock calibration: ${performance_scale}x (${performance_arch})"

resolve_test_selection() {
  local selected=""
  local pattern resolved
  for pattern in "$@"; do
    resolved=""
    if [ -e "$pattern" ]; then
      resolved="$pattern"
    elif [ -e "tests/$pattern" ]; then
      resolved="tests/$pattern"
    else
      resolved="$(compgen -G "$pattern" || true)"
      if [ -z "$resolved" ]; then
        resolved="$(compgen -G "tests/$pattern" || true)"
      fi
    fi
    if [ -z "$resolved" ]; then
      echo "❌ No test files matched: $pattern" >&2
      return 1
    fi
    selected="$selected
$resolved"
  done
  printf "%s\n" "$selected" | sed '/^$/d' | sort -u
}

# Discover every CI suite recursively. Directory taxonomy and metadata replace
# the old numeric filename convention; metadata.ci=false is the only opt-out.
if [ "$#" -gt 0 ]; then
    if ! test_files="$(resolve_test_selection "$@")"; then
        exit 1
    fi
else
    if ! test_files=$(python3 - <<'PY'
import re
import sys
from pathlib import Path

import yaml

root = Path("tests")
taxonomy = {
    "execution": {"concurrency", "operators"},
    "integration": {"import", "query-shapes", "regressions"},
    "performance": {None},
    "planner": {"aggregates", "core", "joins", "order-window", "set-operations", "subqueries"},
    "rdf": {None},
    "sql": {"compatibility", "ddl", "dml", "expressions", "security", "triggers"},
    "storage": {"formats", "indexes", "persistence"},
}
name_pattern = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*\.yaml$")
errors = []
selected = []

for path in sorted(root.rglob("*.yaml")):
    relative = path.relative_to(root)
    parts = relative.parts
    area = parts[0] if len(parts) > 1 else None
    section = parts[1] if len(parts) > 2 else None
    if area not in taxonomy or section not in taxonomy.get(area, set()):
        errors.append(f"{path}: path is outside the documented test taxonomy")
        continue
    if not name_pattern.fullmatch(path.name):
        errors.append(f"{path}: suite filename must be lower kebab-case without a numeric prefix")
        continue
    try:
        with path.open("r", encoding="utf-8") as handle:
            spec = yaml.safe_load(handle) or {}
    except Exception as exc:
        errors.append(f"{path}: cannot parse YAML: {exc}")
        continue
    metadata = spec.get("metadata", {}) if isinstance(spec, dict) else {}
    if not isinstance(metadata, dict) or not metadata.get("description"):
        errors.append(f"{path}: metadata.description is required")
        continue
    if metadata.get("ci", True) is not False:
        selected.append(str(path))

if errors:
    print("\n".join(f"ERROR: {error}" for error in errors), file=sys.stderr)
    raise SystemExit(1)
print("\n".join(selected))
PY
    ); then
        exit 1
    fi
fi
mapfile -t test_files_arr <<< "$test_files"

if [ -z "$test_files" ]; then
    echo "❌ No test files found in tests/ directory"
    exit 1
fi

if [ "$fail_fast_mode" -eq 1 ]; then
  mapfile -t test_files_arr < <(python3 - "${test_files_arr[@]}" <<'PY'
import json
import sys

try:
    with open(".perf_baseline.json", "r", encoding="utf-8") as f:
        config = json.load(f)
        if not isinstance(config, dict):
            config = {}
except (FileNotFoundError, json.JSONDecodeError):
    config = {}

runner = config.get("_runner", {})
failure_map = runner.get("failures", {}) if isinstance(runner, dict) else {}

def failures(spec_file: str) -> int:
    try:
        return max(0, int(failure_map.get(spec_file, 0) or 0))
    except (TypeError, ValueError):
        return 0

ordered = sorted(sys.argv[1:], key=lambda spec_file: (-failures(spec_file), spec_file))
for spec_file in ordered:
    print(spec_file)
PY
  )
  test_files=$(printf '%s\n' "${test_files_arr[@]}")
fi

echo "Found test files:"
printf '%s\n' "${test_files_arr[@]}"
echo ""

test_port=${MEMCP_TEST_PORT:-$(( (RANDOM % 10000) + 20000 ))}
test_data_dir="${MEMCP_TEST_DATA_DIR:-/tmp/memcp-sql-tests-$test_port}"
tmpdir=""
supervisor_pid=""
enable_mysql=0

for tf in "${test_files_arr[@]}"; do
  if python3 - "$tf" <<'PY'
import sys, yaml
with open(sys.argv[1], "r", encoding="utf-8") as f:
    spec = yaml.safe_load(f) or {}
metadata = spec.get("metadata", {}) if isinstance(spec, dict) else {}
raise SystemExit(0 if metadata.get("requires_mysql") else 1)
PY
  then
    enable_mysql=1
    break
  fi
done

# Runner contract:
# - All suites use one shared data directory so restart/persistence tests see
#   the same state. The default is a port-scoped temporary store; callers may
#   set MEMCP_TEST_DATA_DIR to pin a specific test store.
# - The selected data directory must never be deleted by this hook.
# - "isolated" means serialized execution on the same shared database, not
#   storage isolation.
# - restart/SHUTDOWN suites may temporarily stop the shared supervisor, but
#   they must come back on the same data directory afterwards.

run_memcp_forever() {
  trap 'kill $memcp_pid 2>/dev/null; exit 0' TERM INT
  while true; do
    echo "🚀 (re)Starting MemCP on port $test_port..."
    pkill -f "memcp.*--api-port=$test_port" || true
    sleep 1
    memcp_log="${MEMCP_LOG:-/tmp/memcp-test.log}"
    mysql_args=()
    if [ "$enable_mysql" -ne 1 ]; then
      mysql_args+=(--disable-mysql)
    fi
    ./memcp --no-repl -data "$test_data_dir" --api-port=$test_port --mysql-port=$((test_port + 1000)) "${mysql_args[@]}" lib/main.scm >> "$memcp_log" 2>&1 &
    memcp_pid=$!
    wait $memcp_pid
    rc=$?
    if [ $rc -ne 0 ]; then
      echo "⚠️  MemCP exited unexpectedly (code=$rc). Restarting..."
    fi
    sleep 0.5
  done
}

start_supervisor() {
  echo -n > /tmp/memcp-test.log
  run_memcp_forever &
  supervisor_pid=$!

  echo "⏳ Waiting for MemCP to be ready..."
  if wait_for_sql_ready 180 1; then
    echo "✅ MemCP is ready!"
    return 0
  fi
  echo "❌ MemCP did not become SQL-ready"
  return 1
}

stop_supervisor() {
  if [ -n "${supervisor_pid:-}" ]; then
    kill "$supervisor_pid" 2>/dev/null || true
    supervisor_pid=""
  fi
  pkill -f "memcp.*--api-port=$test_port" 2>/dev/null || true
}

wait_for_sql_ready() {
  local retries="${1:-60}"
  local delay="${2:-1}"
  local http_code
  for ((i=1; i<=retries; i++)); do
    if curl -s "http://localhost:$test_port" >/dev/null 2>&1; then
      http_code=$(curl -s -o /dev/null -w "%{http_code}" -u root:admin "http://localhost:$test_port/sql/memcp-tests" -d "SELECT 1")
      if [ "$http_code" = "200" ]; then
        return 0
      fi
    fi
    sleep "$delay"
  done
  return 1
}

if ! start_supervisor; then
  exit 1
fi

cleanup() {
  # Make cleanup idempotent
  if [ "$did_cleanup" -eq 1 ]; then return; fi
  did_cleanup=1
  echo ""; echo "🛑 Stopping MemCP..."
  if [ ${#active_pids[@]} -gt 0 ]; then
    kill "${active_pids[@]}" 2>/dev/null || true
  fi
  for pid in $(jobs -p 2>/dev/null); do
    kill "$pid" 2>/dev/null || true
  done
  stop_supervisor
  if [ -n "$tmpdir" ] && [ -d "$tmpdir" ]; then
    rm -rf "$tmpdir" 2>/dev/null || true
  fi
  echo "✅ MemCP stopped"
}
trap cleanup EXIT
# Handle Ctrl+C and termination signals
trap 'echo; echo "✋ Interrupted"; cleanup; exit 130' INT
trap 'echo; echo "✋ Terminated"; cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP

if [ "$fail_fast_mode" -eq 1 ]; then
  echo "🧪 Running SQL tests using single MemCP instance (fail-fast)..."
else
  echo "🧪 Running SQL tests using single MemCP instance (parallel where safe)..."
fi

all_passed=true
failed_files=""

parallel_tests=()
sequential_tests=()
suite_mode() {
  python3 - "$1" <<'PY'
import sys, yaml
with open(sys.argv[1], "r", encoding="utf-8") as f:
    spec = yaml.safe_load(f) or {}
metadata = spec.get("metadata", {}) if isinstance(spec, dict) else {}
if metadata.get("isolated") or metadata.get("requires_mysql"):
    print("isolated")
    raise SystemExit(0)
for test_case in spec.get("test_cases", []) if isinstance(spec, dict) else []:
    if not isinstance(test_case, dict):
        continue
    if test_case.get("action") == "restart":
        print("isolated")
        raise SystemExit(0)
    sql = test_case.get("sql")
    if isinstance(sql, str) and sql.strip().upper() == "SHUTDOWN":
        print("isolated")
        raise SystemExit(0)
print("shared")
PY
}

# Scheduling contract:
# - shared suites may run in parallel against the long-lived shared MemCP
#   process
# - isolated suites must run one after another, but still on the same ./data
#   database state
for tf in "${test_files_arr[@]}"; do
  if [ "$(suite_mode "$tf")" = "isolated" ]; then
    sequential_tests+=("$tf")
  else
    parallel_tests+=("$tf")
  fi
done

max_jobs="${MEMCP_TEST_JOBS:-4}"
if ! [[ "$max_jobs" =~ ^[0-9]+$ ]] || [ "$max_jobs" -lt 1 ]; then
  max_jobs=4
fi
if [ "$max_jobs" -gt 16 ]; then max_jobs=16; fi

tmpdir=$(mktemp -d)
lockfile="/tmp/memcp-print.lock"

run_one() {
  local tf="$1"
  local out="$2"
  local statusf="$3"
  local -a runner_args=()
  if [ "$fail_fast_mode" -eq 1 ]; then
    runner_args+=("--fail-fast")
  fi
  if ! wait_for_sql_ready 180 1; then
    echo "FAIL" > "$statusf"
    {
      flock -x 9
      echo "❌ $tf: MemCP did not become SQL-ready before running this suite"
      echo ""
    } 9>>"$lockfile"
    return
  fi
  python3 -u run_sql_tests.py "$tf" $test_port --connect-only "${runner_args[@]}" > "$out" 2>&1
  rc=$?
  if [ $rc -eq 0 ]; then
    echo OK > "$statusf"
  else
    echo FAIL > "$statusf"
  fi
  {
    flock -x 9
    cat "$out"
    echo ""
  } 9>>"$lockfile"
}

print_scm_coverage_report() {
  if [ "${MEMCP_COVERAGE:-}" != "1" ]; then
    return
  fi
  echo ""
  echo "📊 Generating SCM coverage report..."
  if ! wait_for_sql_ready 15 1; then
    echo "   ⚠️  MemCP is not SQL-ready; SCM coverage unavailable"
    return
  fi
  local scm_coverage_json
  scm_coverage_json="$(curl -sS -f -u root:admin "http://localhost:$test_port/scm" -d '(source_coverage_report "lib/")' 2>/dev/null || true)"
  if [ -z "$scm_coverage_json" ]; then
    echo "   ⚠️  No SCM coverage data collected"
    return
  fi
  local scm_coverage_file
  if [ -n "${GOCOVERDIR:-}" ] && [ -d "$GOCOVERDIR" ]; then
    scm_coverage_file="$GOCOVERDIR/scm-coverage.json"
  else
    scm_coverage_file="$tmpdir/scm-coverage.json"
  fi
  printf '%s\n' "$scm_coverage_json" > "$scm_coverage_file"
  python3 - "$scm_coverage_file" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        report = json.load(f)
except json.JSONDecodeError as exc:
    print(f"   ⚠️  Could not parse SCM coverage JSON: {exc}")
    raise SystemExit(0)

def assoc_to_dict(value):
    if isinstance(value, list):
        if len(value) % 2 == 0 and all(isinstance(value[i], str) for i in range(0, len(value), 2)):
            return {value[i]: assoc_to_dict(value[i + 1]) for i in range(0, len(value), 2)}
        return [assoc_to_dict(item) for item in value]
    return value

report = assoc_to_dict(report)

total = int(report.get("total", 0) or 0)
covered = int(report.get("covered", 0) or 0)
percent = float(report.get("percent", 100.0) or 0.0)
print(f"   total: {covered}/{total} source nodes covered ({percent:.1f}%)")

files = report.get("files", [])
gaps = [
    f for f in files
    if isinstance(f, dict) and f.get("uncovered_lines")
]
gaps.sort(key=lambda f: (float(f.get("percent", 100.0) or 0.0), str(f.get("source", ""))))
if not gaps:
    print("   No SCM coverage gaps in lib/")
else:
    print("   Largest SCM coverage gaps in lib/:")
    for f in gaps[:20]:
        uncovered_lines = sorted(int(line) for line in f.get("uncovered_lines", []))
        lines = [str(line) for line in uncovered_lines[:24]]
        suffix = ""
        if len(uncovered_lines) > 24:
            suffix = ", ..."
        print(
            "   "
            + f"{f.get('source')}: {int(f.get('covered', 0) or 0)}/{int(f.get('total', 0) or 0)} "
            + f"({float(f.get('percent', 0.0) or 0.0):.1f}%), uncovered lines: "
            + ", ".join(lines)
            + suffix
        )
PY
  if [ -n "${GOCOVERDIR:-}" ] && [ -d "$GOCOVERDIR" ]; then
    echo "   Full report: $GOCOVERDIR/scm-coverage.json"
  fi
}

if [ "$fail_fast_mode" -eq 1 ]; then
  for idx in "${!test_files_arr[@]}"; do
    tf="${test_files_arr[$idx]}"
    out="$tmpdir/$(basename "$tf").out"
    statusf="$tmpdir/$(basename "$tf").status"
    run_one "$tf" "$out" "$statusf"
    if [ ! -f "$statusf" ] || ! grep -q OK "$statusf"; then
      all_passed=false
      remaining_files=$(( ${#test_files_arr[@]} - idx - 1 ))
      if [ "$remaining_files" -gt 0 ]; then
        for skipped_tf in "${test_files_arr[@]:$((idx + 1))}"; do
          echo SKIP > "$tmpdir/$(basename "$skipped_tf").status"
        done
        echo "⏭️  Fail-fast skipped $remaining_files suite files after the first failure"
      fi
      break
    fi
  done
else
  for tf in "${parallel_tests[@]}"; do
    out="$tmpdir/$(basename "$tf").out"
    statusf="$tmpdir/$(basename "$tf").status"
    run_one "$tf" "$out" "$statusf" &
    active_pids+=("$!")
    while [ ${#active_pids[@]} -ge $max_jobs ]; do
      wait "${active_pids[0]}"
      active_pids=("${active_pids[@]:1}")
    done
  done

  for pid in "${active_pids[@]}"; do
    wait "$pid"
  done
  active_pids=()

  for tf in "${sequential_tests[@]}"; do
    out="$tmpdir/$(basename "$tf").out"
    statusf="$tmpdir/$(basename "$tf").status"
    run_one "$tf" "$out" "$statusf"
  done
fi

print_scm_coverage_report
stop_supervisor

for tf in "${test_files_arr[@]}"; do
  statusf="$tmpdir/$(basename "$tf").status"
  if [ -f "$statusf" ] && grep -q OK "$statusf"; then
    :
  elif [ -f "$statusf" ] && grep -q SKIP "$statusf"; then
    :
  else
    all_passed=false
    failed_files="$failed_files $tf"
  fi
done

if [ "$all_passed" != true ]; then
  echo ""
  echo "🔎 Detailed failure logs:"
  for tf in "${test_files_arr[@]}"; do
    statusf="$tmpdir/$(basename "$tf").status"
    if [ -f "$statusf" ] && grep -q OK "$statusf"; then
      continue
    fi
    if [ -f "$statusf" ] && grep -q SKIP "$statusf"; then
      continue
    fi
    echo ""
    echo "===== $(basename "$tf") ====="
    out="$tmpdir/$(basename "$tf").out"
    if [ -f "$out" ]; then
      cat "$out"
    else
      echo "(no output captured)"
    fi
    echo "===== end $(basename "$tf") ====="
  done
  echo ""
fi

rm -rf "$tmpdir"
tmpdir=""

# Generate coverage report if coverage mode was enabled
if [ "${MEMCP_COVERAGE:-}" = "1" ] && [ -d "$GOCOVERDIR" ]; then
    echo ""
    echo "📊 Generating Go coverage report..."
    if ls "$GOCOVERDIR"/*.* >/dev/null 2>&1; then
        go tool covdata textfmt -i="$GOCOVERDIR" -o="$GOCOVERDIR/coverage.out" 2>/dev/null
        if [ -f "$GOCOVERDIR/coverage.out" ]; then
            go tool cover -func="$GOCOVERDIR/coverage.out" | tail -1
            echo "   Full report: go tool cover -html=$GOCOVERDIR/coverage.out"
        fi
    else
        echo "   ⚠️  No coverage data collected"
    fi
fi

if [ "$all_passed" = true ]; then
    echo "🎉 All tests passed, commit allowed"
    exit 0
else
    echo "❌ Some tests failed, commit aborted"
    echo ""
    echo "Failed test files:$failed_files"
    echo ""
    echo "You can run individual test files manually with:"
    echo "  python3 run_sql_tests.py <test_file.yaml> $test_port --connect-only"
    echo "  (Make sure to start MemCP first: ./memcp --api-port=$test_port --disable-mysql)"
    exit 1
fi
