set -eu

create_user() {
	if ! getent group memcp >/dev/null 2>&1; then
		addgroup --system memcp
	fi
	if ! getent passwd memcp >/dev/null 2>&1; then
		adduser --system --no-create-home --home /var/lib/memcp \
			--ingroup memcp --gecos "memcp database daemon" memcp
	fi
}

configure_service() {
	chown root:memcp /etc/memcp/memcp.conf
	chmod 640 /etc/memcp/memcp.conf

	# The old-version argument is empty only on a fresh installation. Upgrades
	# retain both the existing data directory and its credentials unchanged.
	if [ -z "${2:-}" ]; then
		/usr/lib/memcp/initialize
	fi

	deb-systemd-helper unmask memcp.service >/dev/null || true
	if [ -z "${2:-}" ] || deb-systemd-helper --quiet was-enabled memcp.service; then
		deb-systemd-helper enable memcp.service >/dev/null || true
	else
		deb-systemd-helper update-state memcp.service >/dev/null || true
	fi

	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		deb-systemd-invoke restart memcp.service >/dev/null
	fi
}

case "${1:-}" in
	configure)
		create_user
		configure_service "$@"
		;;
esac

exit 0
