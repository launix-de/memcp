set -eu

case "${1:-}" in
	remove|purge)
		if [ -d /run/systemd/system ]; then
			systemctl --system daemon-reload >/dev/null || true
		fi
		;;
esac

case "${1:-}" in
	purge)
		deb-systemd-helper purge memcp.service >/dev/null || true
		# Database contents, the service account, and the one-time credential
		# are deliberately retained. Removing a database package must never be
		# an implicit data-destruction operation.
		if [ -d /var/lib/memcp ] || [ -e /etc/memcp/initial-root-password ]; then
			printf '%s\n' \
				'memcp: database data and initial credentials were preserved' >&2
		fi
		;;
esac

exit 0
