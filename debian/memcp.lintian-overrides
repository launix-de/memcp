# The configuration is restricted because it controls database
# listeners; the HTML files are runtime dashboard assets, not documentation.
memcp: non-standard-file-perm 0640 != 0644 [etc/memcp/memcp.conf]
memcp: package-contains-documentation-outside-usr-share-doc [usr/lib/memcp/assets/dashboard.html]
memcp: package-contains-documentation-outside-usr-share-doc [usr/lib/memcp/assets/info.html]
# The separately released PHP embed runtime includes its upstream-maintained
# fileinfo/libmagic and GD code. MemCP ships the runtime binary and its notices;
# it does not maintain a source copy of either library.
memcp: embedded-library file [usr/lib/memcp/php/libphp.so]
memcp: embedded-library libgd [usr/lib/memcp/php/libphp.so]
